Create the file:

nano KafkaTopicCreator.java

Paste the exact PDF code:

package com.example.kafka;

import org.apache.kafka.clients.admin.AdminClient;
import org.apache.kafka.clients.admin.AdminClientConfig;
import org.apache.kafka.clients.admin.NewTopic;

import java.util.Collections;
import java.util.Properties;
import java.util.Scanner;

public class KafkaTopicCreator {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter topic name: ");
        String topicName = scanner.nextLine().trim();

        // Validate topic name
        if (topicName.isEmpty() ||
            !topicName.matches("[a-zA-Z0-9._-]+")) {

            System.out.println(
                "Invalid topic name. Use only letters, numbers, dots (.), underscores (_), or hyphens (-)."
            );

            scanner.close();
            return;
        }

        Properties props = new Properties();

        // Kafka is currently exposed on localhost:9092
        props.put(
            AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG,
            "localhost:9092"
        );

        try (AdminClient adminClient = AdminClient.create(props)) {

            NewTopic newTopic = new NewTopic(
                topicName,
                1,
                (short) 1
            );

            adminClient
                .createTopics(Collections.singletonList(newTopic))
                .all()
                .get();

            System.out.println(
                "Topic \"" + topicName + "\" created successfully!"
            );

        } catch (Exception e) {

            if (e.getCause() != null) {

                System.out.println(
                    "Topic creation failed: " +
                    e.getCause().getMessage()
                );

            } else {

                System.out.println(
                    "Topic creation failed: " +
                    e.getMessage()
                );
            }

        } finally {

            scanner.close();
        }
    }
}

