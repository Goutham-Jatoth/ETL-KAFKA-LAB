PART 6 — Create KafkaConsumerExample.java

Run:

nano KafkaConsumerExample.java

Paste exactly:

package com.example.kafka;

import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.apache.kafka.clients.consumer.ConsumerRecords;
import org.apache.kafka.clients.consumer.KafkaConsumer;
import org.apache.kafka.common.serialization.StringDeserializer;

import java.time.Duration;
import java.util.Collections;
import java.util.Properties;
import java.util.Scanner;

public class KafkaConsumerExample {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter topic name: ");
        String topic = scanner.nextLine().trim();

        // Validate topic name
        if (topic.isEmpty() ||
            !topic.matches("[a-zA-Z0-9._-]+")) {

            System.out.println(
                "Invalid topic name. Use only letters, numbers, " +
                "dots (.), underscores (_), or hyphens (-)."
            );

            scanner.close();
            return;
        }

        Properties props = new Properties();

        // Kafka is currently running on localhost:9092
        props.put(
            ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG,
            "localhost:9092"
        );

        // Consumer group ID
        props.put(
            ConsumerConfig.GROUP_ID_CONFIG,
            "test-group"
        );

        // Key deserializer
        props.put(
            ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG,
            StringDeserializer.class.getName()
        );

        // Value deserializer
        props.put(
            ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG,
            StringDeserializer.class.getName()
        );

        // Read from beginning if this consumer group has no offset
        props.put(
            ConsumerConfig.AUTO_OFFSET_RESET_CONFIG,
            "earliest"
        );

        try (
            KafkaConsumer<String, String> consumer =
                new KafkaConsumer<>(props)
        ) {

            consumer.subscribe(
                Collections.singletonList(topic)
            );

            System.out.println("Kafka Consumer started.");

            System.out.println(
                "Waiting for messages on topic \"" +
                topic + "\"..."
            );

            // Continuously poll for messages
            while (true) {

                ConsumerRecords<String, String> records =
                    consumer.poll(Duration.ofMillis(1000));

                for (ConsumerRecord<String, String> record : records) {

                    System.out.printf(
                        "Received message: key=%s, value=%s, " +
                        "partition=%d, offset=%d%n",
                        record.key(),
                        record.value(),
                        record.partition(),
                        record.offset()
                    );
                }
            }

        } catch (Exception e) {

            System.err.println(
                "Error in Kafka Consumer:"
            );

            e.printStackTrace();

        } finally {

            scanner.close();
        }
    }
}

